#version 450

layout(binding = 0, rgba8) uniform image2D canvasImage;
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform PushData {
	vec4 Colour;
	vec2 MousePos;
	vec2 PrevMousePos;
    int Shape;
	float Radius;
    bool Antialiased;
} PushConstants;

float sdCircle(vec2 pos, float radius)
{
    return length(pos) - radius;
}

float sdSquare(vec2 pos, float radius)
{
    return length(min(pos, -radius) + max(pos, radius));
}

float sdTriangle(vec2 pos, float radius)
{
    const float k = sqrt(3.0);

    pos.x = abs(pos.x) - radius;
    pos.y = pos.y + radius / k;

    if (pos.x + k * pos.y > 0.0)
    {
        pos = vec2(pos.x - k * pos.y, -k * pos.x - pos.y) / 2.0;
    }

    pos.x -= clamp(pos.x, -2.0 * radius, 0.0);
    return -length(pos) * sign(pos.y);
}

void main()
{
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 pixelPos = vec2(pixelCoord);

    vec2 strokeDelta = PushConstants.MousePos - PushConstants.PrevMousePos;
    float strokeLength = length(strokeDelta);

    float spacing = max(PushConstants.Radius * 0.5, 1.0);
    int stepCount = max(1, int(ceil(strokeLength / spacing)));

    vec4 resultColour = imageLoad(canvasImage, pixelCoord);
    float aaWidth = 2.0;

    for (int i = 0; i <= stepCount; i++)
    {
        float t = float(i) / float(stepCount);
        vec2 samplePos = mix(PushConstants.PrevMousePos, PushConstants.MousePos, t);

        vec2 localPos = pixelPos - samplePos;

        float signedDistance;
        if (PushConstants.Shape == 0) signedDistance = sdCircle(localPos, PushConstants.Radius);
        else if (PushConstants.Shape == 1) signedDistance = sdSquare(localPos, PushConstants.Radius);
        else if (PushConstants.Shape == 3) signedDistance = sdTriangle(localPos, PushConstants.Radius);

        if (PushConstants.Antialiased)
        {
            float alpha = 1.0 - smoothstep(-aaWidth, aaWidth, signedDistance);
            resultColour = mix(resultColour, PushConstants.Colour, alpha);
        }
        else
        {
            if (signedDistance <= 0.0)
            {
                resultColour = PushConstants.Colour;
            }
        }
    }

    imageStore(canvasImage, pixelCoord, resultColour);
}
